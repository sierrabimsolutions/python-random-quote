<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>RevitBeamCalculator</AssemblyName>
    <RootNamespace>RevitBeamCalculator</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Structural Engineering Team</Authors>
    <Description>Revit add-in for gravity beam calculations based on diaphragm definitions</Description>
  </PropertyGroup>

  <!-- Revit API References - Update paths based on your Revit installation -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
    <PackageReference Include="EPPlus" Version="6.2.10" />
    <PackageReference Include="QuestPDF" Version="2023.12.0" />
  </ItemGroup>

  <!-- Resource Files -->
  <ItemGroup>
    <Resource Include="..\resources\**\*" />
  </ItemGroup>

</Project>
