<Window x:Class="RevitBeamCalculator.UI.BatchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Analysis Results"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Total Beams" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalBeamsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Passed" FontSize="12" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PassedText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Failed" FontSize="12" Foreground="#F44336" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FailedText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Errors" FontSize="12" Foreground="#FF9800" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Grid -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="16">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="32"
                      CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Beam Mark" Binding="{Binding BeamMark}" Width="100"/>
                    <DataGridTextColumn Header="Section" Binding="{Binding SectionName}" Width="150"/>
                    <DataGridTextColumn Header="Length (ft)" Binding="{Binding Length}" Width="80"/>
                    <DataGridTextColumn Header="Max Moment" Binding="{Binding MaxMoment}" Width="100"/>
                    <DataGridTextColumn Header="Max Shear" Binding="{Binding MaxShear}" Width="80"/>
                    <DataGridTextColumn Header="D/C Ratio" Binding="{Binding DCRatio}" Width="80"/>
                    <DataGridTemplateColumn Header="Status" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}"
                                           FontWeight="Bold"
                                           Foreground="{Binding StatusColor}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Governing Check" Binding="{Binding GoverningCheck}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          x:Name="WriteToModelCheckbox"
                          Content="Write results to model parameters"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Export All to Excel" Padding="16,8" Margin="4,0" Click="ExportExcel_Click"/>
                    <Button Content="Export All to PDF" Padding="16,8" Margin="4,0" Click="ExportPdf_Click"/>
                    <Button Content="Close" Padding="16,8" Margin="4,0" Click="Close_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
